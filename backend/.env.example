# ==============================================================================
# PizzaDelight Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and update values for your environment:
#   cp .env.example .env
# Never commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server HTTP Port
PORT=5000

# MongoDB Connection URI (Local MongoDB or MongoDB Atlas connection string)
MONGO_URI=mongodb://127.0.0.1:27017/pizza_delivery

# JSON Web Token Configuration
# CRITICAL: In production, JWT_SECRET MUST be at least 32 characters long.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=1d

# Allowed Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# ==============================================================================
# Email & SMTP Configuration
# NOTE: Leave SMTP_HOST, SMTP_USER, and SMTP_PASS empty during local development
# to automatically simulate outgoing emails (OTP & reset codes) in the server console log.
# ==============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
# Verified sender email address (SMTP_FROM is also supported as legacy alias)
EMAIL_FROM=no-reply@example.com
# Recipient email address for automated low-stock inventory alerts
ADMIN_EMAIL=admin@example.com

# ==============================================================================
# Razorpay Payment Gateway Configuration (Test Mode)
# Obtain test credentials from Razorpay Dashboard: Settings -> API Keys
# ==============================================================================
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_CURRENCY=INR

# ==============================================================================
# Internal Scheduler Secret
# Bearer token used to authenticate calls to protected internal endpoints,
# such as POST /api/internal/cron/low-stock (or POST /api/internal/low-stock).
# ==============================================================================
CRON_SECRET=replace_with_a_secure_cron_secret

# ==============================================================================
# Optional Security Settings
# ==============================================================================
# Maximum requests per 15-minute window for auth endpoints (default: 100)
# AUTH_RATE_LIMIT=100


