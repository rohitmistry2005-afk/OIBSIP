# ==============================================================================
# PizzaDelight Frontend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting development:
#   cp .env.example .env
# ==============================================================================

# Backend API Base URL (must point to backend server /api prefix)
VITE_API_URL=http://localhost:5000/api

# Razorpay Key ID (Optional fallback; dynamically provided by backend order endpoint at runtime)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

